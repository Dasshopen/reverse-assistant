{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reverse Assistant",
  "version": "0.1.3",
  "identifier": "com.dasshopen.reverse-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Reverse Assistant",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4RDlCNkFEQzMzMTc1M0EKUldRNmRUSERyYmJadUNjTUNZVTc0c2N0K3RGZzlwUWlOQTl3R3pSbE9WL2x4L1UrWlZJNVFLZjYK",
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "endpoints": ["https://raw.githubusercontent.com/Dasshopen/reverse-assistant/main/updates/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../ghidra-extension/ReverseAssistantExporter/build.gradle": "managed/extension-source/build.gradle",
      "../ghidra-extension/ReverseAssistantExporter/extension.properties": "managed/extension-source/extension.properties",
      "../ghidra-extension/ReverseAssistantExporter/Module.manifest": "managed/extension-source/Module.manifest",
      "../ghidra-extension/ReverseAssistantExporter/src": "managed/extension-source/src",
      "../ghidra-extension/ReverseAssistantExporter/ghidra_scripts": "managed/extension-source/ghidra_scripts",
      "../bsim-corpus/build/reverse-assistant-seed.mv.db": "managed/reverse-assistant-seed.mv.db"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
