{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reverse Assistant",
  "version": "0.1.0",
  "identifier": "com.dasshopen.reverse-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Reverse Assistant",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../ghidra-extension/ReverseAssistantExporter/build.gradle": "managed/extension-source/build.gradle",
      "../ghidra-extension/ReverseAssistantExporter/extension.properties": "managed/extension-source/extension.properties",
      "../ghidra-extension/ReverseAssistantExporter/Module.manifest": "managed/extension-source/Module.manifest",
      "../ghidra-extension/ReverseAssistantExporter/src": "managed/extension-source/src",
      "../ghidra-extension/ReverseAssistantExporter/ghidra_scripts": "managed/extension-source/ghidra_scripts",
      "../bsim-corpus/build/reverse-assistant-seed.mv.db": "managed/reverse-assistant-seed.mv.db"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
